#include <windows.h>

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080404B0"
    BEGIN
      VALUE "CompanyName", "MiEarphonePC Open Native"
      VALUE "FileDescription", "小米耳机 · PC 原生控制中心"
      VALUE "FileVersion", "2.0.0"
      VALUE "InternalName", "MiEarphonePC"
      VALUE "OriginalFilename", "MiEarphonePC.exe"
      VALUE "ProductName", "小米耳机 · PC"
      VALUE "ProductVersion", "2.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
